---
import { Image } from 'astro:assets';
// Pre-rendered from the original SVG blur; a live feGaussianBlur is expensive to rasterize.
import blurryGradient from '@/assets/blurry-gradient.webp';

type Props = {
  eager?: boolean;
};

const { eager = false } = Astro.props;
---

<Image
  src={blurryGradient}
  alt=""
  aria-hidden="true"
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  class="pointer-events-none absolute h-full w-full object-cover select-none"
/>
