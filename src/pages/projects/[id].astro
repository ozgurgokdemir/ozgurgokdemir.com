---
import { getCollection, render } from 'astro:content';
import ProjectDetailsLayout from '@/layouts/project-details-layout.astro';
import { Image } from 'astro:assets';
import LinkButton from '@/components/link-button.astro';
import Icon from '@/components/icon.astro';
import BlurryGradient from '@/assets/blurry-gradient.svg';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const hasDetails = Boolean(project.body?.trim());
const renderedProject = hasDetails ? await render(project) : null;
const Content = renderedProject?.Content;
const siteURL = Astro.site ?? new URL(Astro.url.origin);
const pageTitle = `${project.data.title} - Özgür Gökdemir`;
const projectURL = new URL(`/projects/${project.id}/`, siteURL).toString();
const projectImageAlt = `${project.data.title} project preview`;
const linkDetails = {
  website: { label: 'View site', icon: 'heroicons:eye-16-solid' },
  'web-app': { label: 'View app', icon: 'heroicons:eye-16-solid' },
  'app-store': {
    label: 'View on the App Store',
    icon: 'heroicons:device-phone-mobile-16-solid',
  },
  'google-play': {
    label: 'Get it on Google Play',
    icon: 'heroicons:device-phone-mobile-16-solid',
  },
  source: { label: 'Source code', icon: 'heroicons:code-bracket-16-solid' },
} as const;
const projectLinks = project.data.links.map(({ url }) => url);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: project.data.title,
    description: project.data.description,
    url: projectURL,
    image: new URL('/open-graph-image.png', siteURL).toString(),
    creator: {
      '@type': 'Person',
      name: 'Özgür Gökdemir',
      url: new URL('/', siteURL).toString(),
    },
    sameAs: projectLinks,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: new URL('/', siteURL).toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Projects',
        item: new URL('/projects/', siteURL).toString(),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: project.data.title,
        item: projectURL,
      },
    ],
  },
];
---

<ProjectDetailsLayout
  title={pageTitle}
  description={project.data.description}
  type="article"
  imageAlt={projectImageAlt}
  {jsonLd}
>
  <div data-animate>
    <section
      class="relative px-4 before:absolute before:inset-0 before:-z-10 before:bg-radial-[circle_farthest-side_at_top] before:from-(--gradient-color) before:opacity-30"
      style={`--gradient-color:${project.data.color};`}
    >
      <div
        class="mx-auto flex max-w-360 flex-col gap-16 pt-32 pb-16 md:gap-24 md:pt-36 md:pb-24"
      >
        <div
          class="mx-auto flex w-full max-w-4xl flex-col gap-4 md:flex-row md:justify-between"
        >
          <div class="flex flex-col gap-4 md:gap-2">
            <h1
              class="scroll-animations-hidden text-3xl font-semibold"
              data-stagger-index="0"
            >
              {project.data.title}
            </h1>
            <p
              class="text-muted-foreground scroll-animations-hidden text-lg"
              data-stagger-index="1"
            >
              {project.data.description}
            </p>
          </div>
          {
            project.data.links.length > 0 && (
              <div
                class="scroll-animations-hidden mt-2 flex flex-wrap gap-4 md:flex-row"
                data-stagger-index="2"
              >
                {project.data.links.map((link) => {
                  const details = linkDetails[link.type];

                  return (
                    <LinkButton
                      href={link.url}
                      target="_blank"
                      variant="outline"
                    >
                      <Icon name={details.icon} size={16} />
                      {details.label}
                    </LinkButton>
                  );
                })}
              </div>
            )
          }
        </div>
        <div
          class="scroll-animations-hidden relative aspect-video overflow-hidden rounded-[1.25rem] bg-cover bg-center"
          data-stagger-index="3"
        >
          <BlurryGradient class="absolute h-full w-full" />
          <Image
            src={project.data.image}
            alt={projectImageAlt}
            width={1536}
            height={864}
            layout="constrained"
            priority={true}
            class="pointer-events-none absolute top-1/10 left-1/8 scale-110 skew-x-4 -skew-y-12 rounded-lg ring-[clamp(0.25rem,1vw,0.5rem)] ring-black/10 select-none md:rounded-2xl"
          />
        </div>
      </div>
    </section>
    {
      Content && (
        <article
          class="project-details-prose scroll-animations-hidden px-4 pb-16 md:px-0 md:pb-24"
          data-stagger-index="4"
        >
          <Content />
        </article>
      )
    }
  </div>
</ProjectDetailsLayout>
